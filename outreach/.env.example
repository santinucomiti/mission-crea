# Un mot de passe par personne : il identifie qui est connecté (prénom:motdepasse, séparés par des virgules)
OUTREACH_USERS=Santinu:change-moi,Eva:change-moi,Rémi:change-moi
# Comptes en lecture seule (voient tout, ne modifient rien) — leur mot de passe va aussi dans OUTREACH_USERS.
OUTREACH_READONLY=
# Administrateurs (bouton « Sauvegarde » : téléchargement de la base SQLite complète). Prénoms séparés par des virgules.
OUTREACH_ADMIN=Santinu
# Secret aléatoire pour signer le cookie de session (openssl rand -hex 32)
OUTREACH_SECRET=change-moi-aussi
PORT=3500
DB_PATH=./data/outreach.sqlite
# Fichiers uploadés (audio, documents), 500 Mo max par fichier
FILES_DIR=./data/files
PHOTOS_DIR=./data/photos
MAX_FILE_MB=500

# Synchro Notion (entretiens réalisés, deux sens) : intégration interne + base « Liste de contacts » partagée avec elle
NOTION_TOKEN=
NOTION_DB_ID=3d47651dd081802187d9ccaeb4130c4c
NOTION_CRM_URL=https://missioncrea.clippingatlas.com
# NOTION_SYNC=off coupe la synchro (cycle de 10 min et bouton) sans retirer le jeton.
NOTION_SYNC=on
