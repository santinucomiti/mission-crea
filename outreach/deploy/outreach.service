[Unit]
Description=Outreach (suivi de prospection Mission Créa)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/outreach
EnvironmentFile=/home/ubuntu/outreach/.env
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
